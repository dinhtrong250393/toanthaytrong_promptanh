rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isTeacherAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'dinhtrong250393@gmail.com';
    }

    function isAllowedGroupId(groupId) {
      return groupId in ['group_1', 'group_2', 'group_4', 'group_5'];
    }

    function isValidClassroomGroup(data) {
      return data.keys().hasAll([
          'groupNumber',
          'title',
          'groupInput',
          'theoryText',
          'resultImageUrl',
          'authorUid',
          'lastEditorUid',
          'lastEditorName',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'groupNumber',
          'title',
          'groupInput',
          'theoryText',
          'resultImageUrl',
          'authorUid',
          'lastEditorUid',
          'lastEditorName',
          'createdAt',
          'updatedAt'
        ])
        && data.groupNumber is int
        && data.groupNumber in [1, 2, 4, 5]
        && data.title is string
        && data.title.size() <= 200
        && data.groupInput is string
        && data.groupInput.size() >= 1
        && data.groupInput.size() <= 50
        && data.theoryText is string
        && data.theoryText.size() <= 15000
        && data.resultImageUrl is string
        && data.resultImageUrl.size() <= 500000
        && data.authorUid is string
        && data.authorUid.size() >= 1
        && data.authorUid.size() <= 128
        && data.lastEditorUid is string
        && data.lastEditorUid.size() >= 1
        && data.lastEditorUid.size() <= 128
        && data.lastEditorUid == request.auth.uid
        && data.lastEditorName is string
        && data.lastEditorName.size() >= 1
        && data.lastEditorName.size() <= 80
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /classroomGroups/{groupId} {
      // Allow direct get of non-PII classroom group posters so projector/students see shared boards immediately (no list scraping)
      allow get: if isValidId(groupId) && isAllowedGroupId(groupId);

      // Verified Google users can create initial group board documents
      allow create: if isVerifiedUser()
        && isValidId(groupId)
        && isAllowedGroupId(groupId)
        && isValidClassroomGroup(incoming())
        && incoming().authorUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      // Verified Google users can update mutable group board fields; teacher admin can also update cleanly
      allow update: if isVerifiedUser()
        && isValidId(groupId)
        && isAllowedGroupId(groupId)
        && isValidClassroomGroup(incoming())
        && incoming().authorUid == existing().authorUid
        && incoming().createdAt == existing().createdAt
        && incoming().groupNumber == existing().groupNumber
        && incoming().updatedAt == request.time
        && (
          isTeacherAdmin()
          || incoming().diff(existing()).affectedKeys().hasOnly([
            'title',
            'groupInput',
            'theoryText',
            'resultImageUrl',
            'lastEditorUid',
            'lastEditorName',
            'updatedAt'
          ])
        );

      allow delete: if isTeacherAdmin() && isValidId(groupId) && isAllowedGroupId(groupId);
    }
  }
}
